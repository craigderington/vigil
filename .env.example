# Copy to .env and adjust as needed. docker-compose.yml forwards each of
# these into the container's environment; unset values fall back to the
# defaults shown here.

# Host:port the container binds to internally. Rarely needs changing. If you
# change the PORT half of this, the Docker healthcheck (`vigil healthcheck`)
# derives its probe port from this same value, so it stays in sync
# automatically — no other file needs editing.
VIGIL_BIND=0.0.0.0:8080

# Global cap on simultaneous probes in flight.
VIGIL_MAX_CONCURRENCY=25

# Host port published by `docker compose up` (container always listens on
# the VIGIL_BIND port internally, 8080 by default). Change this if 8080 is
# already taken on your host.
VIGIL_HOST_PORT=8080
