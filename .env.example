# Copy to .env and adjust as needed. docker-compose.yml reads these
# automatically; unset values fall back to the defaults shown here.

# Host:port the container binds to internally. Rarely needs changing.
VIGIL_BIND=0.0.0.0:8080

# Global cap on simultaneous probes in flight.
VIGIL_MAX_CONCURRENCY=25

# Host port published by `docker compose up` (container always listens on
# 8080 internally). Change this if 8080 is already taken on your host.
VIGIL_HOST_PORT=8080
